# ═══════════════════════════════════════════════════════════════
#  miniagent configuration — all settings are read from this file
#  Copy to .env and fill in your keys:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Provider selection ─────────────────────────────────────────
# Which built-in profile is active at startup: deepseek | stepfun | minimax.
# At runtime, models can be added / switched from the Web UI (header selector
# → ⚙), or via POST /api/models + /api/models/{id}/activate. Custom models are
# persisted in models.json (gitignored — never commit API keys).
# PROVIDER=deepseek

# ── DeepSeek (required) ───────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_NAME=deepseek-chat

# ── StepFun (alternative to DeepSeek) ─────────────────────────
STEPFUN_API_KEY=your-key-here
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL_NAME=step-3.7-flash

# ── MiniMax (alternative to DeepSeek) ───────────────────────
# OpenAI-compatible Chat Completions API
MINIMAX_API_KEY=your-key-here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL_NAME=MiniMax-M3

# ── Search Backends (optional, at least one recommended) ──────
BOCHA_API_KEY=sk-your-key-here
TAVILY_API_KEY=tvly-dev-your-key-here
SERPAPI_API_KEY=your-key-here
SERPER_API_KEY=your-key-here
LANGSEARCH_API_KEY=sk-your-key-here
ANYSEARCH_API_KEY=as_sk-your-key-here

# ── Academic APIs (optional) ──────────────────────────────────
PUBMED_API_KEY=your-key-here

# ═══════════════════════════════════════════════════════════════
#  Agent Parameters
# ═══════════════════════════════════════════════════════════════

# Maximum tool-call iterations per agent run
MAX_ITERATIONS=35

# Maximum output tokens per LLM call (capped at 393216)
MAX_TOKENS=393216

# Max estimated tokens before history trimming kicks in
AGENT_HISTORY_TOKEN_LIMIT=96000

# Number of recent messages kept verbatim during summarization
AGENT_KEEP_RECENT_MSGS=5

# Max consecutive all-error tool rounds before breaking the agent loop
AGENT_MAX_CONSECUTIVE_ERRORS=3

# ═══════════════════════════════════════════════════════════════
#  Loop Pipeline Parameters
# ═══════════════════════════════════════════════════════════════

# Maximum explore→plan→dispatch→evaluate cycles
LOOP_MAX_LOOPS=10

# Consecutive stagnant loops (no progress) before forced termination
LOOP_NO_PROGRESS_LIMIT=3

# Per-loop token cost threshold — if exceeded AND progress is low, stop early
LOOP_COST_TOKEN_THRESHOLD=30000

# Minimum progress % required to continue when cost threshold is exceeded
LOOP_COST_MIN_PROGRESS=10

# Max tool iterations for the Explore stage agent
LOOP_EXPLORE_MAX_ITERATIONS=10

# Max tool iterations for each dispatched task agent
LOOP_DISPATCH_MAX_ITERATIONS=15

# Max output tokens for stage-level LLM calls
LOOP_PLAN_MAX_TOKENS=4000
LOOP_EXPLORE_MAX_TOKENS=4000
LOOP_EVALUATE_MAX_TOKENS=2000
LOOP_REPAIR_MAX_TOKENS=1500
LOOP_CRITIC_MAX_TOKENS=2000
LOOP_JUDGE_MAX_TOKENS=1000

# ═══════════════════════════════════════════════════════════════
#  Budget
# ═══════════════════════════════════════════════════════════════

# Total token budget across an entire agent session
TOKEN_BUDGET=3000000

# ═══════════════════════════════════════════════════════════════
#  Server
# ═══════════════════════════════════════════════════════════════

# SERVER_HOST=0.0.0.0
# SERVER_PORT=3002
